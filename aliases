# ~/.bashrc: Aspen dev container shell config

case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize

# Colors
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
fi

alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'

export LESS='-R'
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# Git prompt
if [ -f /usr/lib/git-core/git-sh-prompt ]; then
    source /usr/lib/git-core/git-sh-prompt
    export GIT_PS1_SHOWDIRTYSTATE=1
    export GIT_PS1_SHOWSTASHSTATE=1
    export GIT_PS1_SHOWUNTRACKEDFILES=1
    export GIT_PS1_SHOWUPSTREAM="auto"
    export GIT_PS1_SHOWCOLORHINTS=1
    PS1='\[\033[01;32m\]aspen-dev\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(__git_ps1 " (%s)")\[\033[00m\]\$ '
else
    PS1='\[\033[01;32m\]aspen-dev\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi

# Aspen aliases
SITE="${SITE_NAME:-test.localhostaspen}"

alias aspen_logs='(cd /var/log/aspen-discovery/${SITE}/; tail -f ./* ./logs/*)'
alias aspen_dir='cd /usr/local/aspen-discovery/'
alias aspen_code='cd /usr/local/aspen-discovery/code/'
alias aspen_site='cd /usr/local/aspen-discovery/sites/${SITE}/'
alias aspen_koha_import='cd /usr/local/aspen-discovery/code/koha_export; java -jar koha_export.jar ${SITE}; cd -'
alias aspen_reindex='cd /usr/local/aspen-discovery/code/reindexer; java -jar reindexer.jar ${SITE}; cd -'
